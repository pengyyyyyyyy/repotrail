# Copy to the repository root as .env and set a unique database password.
REPOTRAIL_DB_PASSWORD=
REPOTRAIL_PUBLIC_URL=http://127.0.0.1:8766
REPOTRAIL_ALLOWED_HOSTS=localhost,127.0.0.1
REPOTRAIL_BIND=127.0.0.1
REPOTRAIL_PORT=8766
REPOTRAIL_COOKIE_SECURE=0
# Local repositories are mounted read-only at /repositories.
REPOTRAIL_REPOSITORY_ROOT=.
